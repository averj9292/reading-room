{
  "name": "reading-room",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://averj9292.github.io",
    "ACCESS_AUD": "28274e8f3efb0b6849f1511c71c8a16a20907664932e7e777891d633c1f47a54"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reading-room",
      "database_id": "36401c47-d0b6-44ca-ba7c-234f489c5f15"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "730001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CODE_LIMITER",
      "namespace_id": "730002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "ACTIVITY_LIMITER",
      "namespace_id": "730003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
