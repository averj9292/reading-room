{
  "name": "reading-room",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://averj9292.github.io",
    "ACCESS_AUD": "REPLACE_WITH_TEACHER_ACCESS_APPLICATION_AUDIENCE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reading-room",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "730001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CODE_LIMITER",
      "namespace_id": "730002",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    {
      "name": "ACTIVITY_LIMITER",
      "namespace_id": "730003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
